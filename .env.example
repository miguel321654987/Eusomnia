DATABASE_URL=postgresql://gitpod:postgres@localhost:5432/example
FLASK_APP_KEY="any key works"
FLASK_APP=src/app.py
FLASK_DEBUG=1

# Edamam Nutrition Analysis API (B2B)
# Get credentials at https://developer.edamam.com/admin/applications
EDAMAM_APP_ID=your_application_id
EDAMAM_APP_KEY=your_application_key
EDAMAM_BASE_URL=https://api.edamam.com
# Qdrant vector database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=dream_dictionary

# RAG embedding provider (OpenAI-compatible; uses OpenRouter by default)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=openai/text-embedding-3-small

# OpenRouter AI
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key

# JWT secret key (must be >=32 characters for security)
JWT_SECRET_KEY=your-very-long-secret-key-here-32-or-more-chars

