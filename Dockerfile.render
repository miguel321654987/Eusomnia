FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# Install system dependencies
RUN apt-get update \
    && apt-get install -y --no-install-recommends graphviz graphviz-dev gcc curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/app

# Install Python dependencies
COPY Pipfile Pipfile.lock ./
RUN pip install pipenv \
    && pipenv install --system --deploy \
    && pip install "psycopg[binary]"

# Copy project files
COPY . .

EXPOSE 10000
CMD gunicorn --chdir src --bind 0.0.0.0:${PORT:-10000} --timeout 120 wsgi:application